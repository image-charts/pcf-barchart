{
  "name": "@image-charts/pcf-barchart",
  "version": "1.0.0",
  "description": "Image-Charts Bar Chart Generator for Microsoft Power Apps (PCF Component)",
  "main": "solution/ImageChartsBarChart.zip",
  "types": "src/BarChartGenerator/index.d.ts",
  "scripts": {
    "build": "npm run build:pcf && npm run build:solution",
    "build:pcf": "pcf-scripts build",
    "build:solution": "cd Solutions && dotnet build --configuration Release",
    "start": "pcf-scripts start watch",
    "test": "jest --coverage",
    "test:integration": "jest --testPathPatterns=integration",
    "lint": "eslint src/**/*.ts",
    "clean": "rimraf out Solutions/bin Solutions/obj",
    "refreshTypes": "pcf-scripts refreshTypes",
    "postinstall": "node scripts/postinstall.js"
  },
  "keywords": [
    "pcf",
    "powerapps",
    "power-apps",
    "power-platform",
    "image-charts",
    "imagecharts",
    "bar-chart",
    "barchart",
    "chart",
    "dataverse",
    "dynamics365",
    "canvas-app",
    "component-framework"
  ],
  "author": "Image-Charts <support@image-charts.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/image-charts/pcf-barchart.git"
  },
  "bugs": {
    "url": "https://github.com/image-charts/pcf-barchart/issues"
  },
  "homepage": "https://documentation.image-charts.com/integrations/power-apps/",
  "files": [
    "solution/*.zip",
    "src/",
    "scripts/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "crypto-js": "^4.2.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.0.0",
    "@types/powerapps-component-framework": "^1.3.4",
    "eslint": "^9.0.0",
    "jest": "^30.0.0",
    "pcf-scripts": "^1.31.4",
    "rimraf": "^6.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
